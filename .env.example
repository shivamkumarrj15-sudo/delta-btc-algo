# Delta Exchange Configuration
# Set to 'india' for Delta Exchange India (api.india.delta.exchange) or 'global' for Delta Global (api.delta.exchange)
DELTA_EXCHANGE_REGION=india

# API Credentials (leave empty or fill when switching to live trading)
DELTA_API_KEY=
DELTA_API_SECRET=

# Trading Mode: Set to 'true' for Paper Trading ($1000 virtual balance), 'false' for Real Money
PAPER_TRADING=true
INITIAL_PAPER_BALANCE=1000.0

# Trading Pair / Symbol
SYMBOL=BTCUSD

# Risk Management Settings
DAILY_MAX_RISK_PERCENT=2.0
PER_TRADE_RISK_PERCENT=1.0

# Leverage Settings (Dynamic based on confidence)
MIN_LEVERAGE=20
MAX_LEVERAGE=35

# Multi-Stage Take Profit & Trailing Settings (Risk:Reward Ratios)
STAGE_1_RR=2.0      # When 1:2 hit -> SL moves to CTC (Cost to Cost)
STAGE_2_RR=5.0      # When 1:5 hit -> Exit 50% qty & SL moves to 1:2
STAGE_3_RR=10.0     # When 1:10 hit -> Exit remaining 50% qty

# Web Dashboard Port
DASHBOARD_PORT=8501
